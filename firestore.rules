rules_version = '2';
// The real permission layer. Member ids are lowercased school emails; every *Uid field holds one.
// Fields added after launch (public, publicBlurb, touchedAt, mentionUids) are read with get(key, default):
// production documents written before them lack the keys, and a bare read would deny the write.
service cloud.firestore {
  match /databases/{db}/documents {
    function me() { return request.auth.token.email.lower(); }
    function member() { return get(/databases/$(db)/documents/members/$(me())).data; }
    function active() {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(db)/documents/members/$(me())) && member().active == true;
    }
    function role() { return member().role; }
    function isAdvisor() { return role() == 'advisor'; }
    function isBoss() { return role() in ['advisor', 'president', 'vp', 'treasurer', 'secretary']; }
    function isAdmin() { return role() in ['advisor', 'president', 'vp']; }
    function notTeacher() { return role() != 'teacher'; }
    function curTerm() { return get(/databases/$(db)/documents/settings/current).data.termId; }
    function termOk() { return request.resource.data.termId == curTerm(); }
    function roles() { return ['advisor', 'president', 'vp', 'treasurer', 'secretary', 'officer', 'member', 'teacher']; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function fixed(keys) { return !changed().hasAny(keys); }
    function text(s, lo, hi) { return s is string && s.size() >= lo && s.size() <= hi; }
    function day(s) { return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function hhmm(s) { return s is string && s.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'); }
    // Google Docs and Drive links only: a fixed host, a known path, plain URL characters, and no dot-segments or
    // encoded dots and slashes, so neither look-alike hosts nor the docs.google.com/url redirector get through.
    function google(u) {
      return u is string && u.size() <= 500
        && u.matches('^[A-Za-z0-9._~:/?#&=%+!$()*,;@-]+$') && !u.matches('.*([.][.]|%2[eEfF]|%5[cC]).*')
        && (u.matches('^https://docs[.]google[.]com/(document|spreadsheets|presentation|forms|drawings)/(u/[0-9]+/)?d/[A-Za-z0-9_-]+([/?#].*)?$')
          || u.matches('^https://drive[.]google[.]com/((u/[0-9]+/)?(file/d|drive/folders|drive/u/[0-9]+/folders)/[A-Za-z0-9_-]+|open[?]id=[A-Za-z0-9_-]+)([/?#&].*)?$'));
    }
    function optString(d, k) { return d.get(k, null) == null || d.get(k, null) is string; }

    function memberOk(d) {
      return d.role in roles() && d.active is bool && text(d.get('name', 'x'), 1, 60) && text(d.get('section', ''), 0, 60)
        && (d.get('reportsTo', null) == null || d.get('reportsTo', null) is string)
        && optString(d, 'departmentId') && d.get('position', null) in [null, 'jc_officer', 'sec_officer', 'member'];
    }
    // A department's JC officer or Sec officer, read from the stored department.
    function leadOf(id) {
      let d = get(/databases/$(db)/documents/departments/$(id)).data;
      return d.termId == curTerm() && (d.get('jcLeadUid', null) == me() || d.get('secLeadUid', null) == me());
    }
    // Leads add a person with no department to theirs, or remove one of their general members. Nothing else.
    function deptLeadMemberEdit(email) {
      let a = request.resource.data;
      let b = resource.data;
      return email != me() && changed().hasOnly(['departmentId', 'position', 'reportsTo', 'updatedAt', 'termId'])
        && b.get('position', null) in [null, 'member'] && a.get('position', null) in [null, 'member']
        && ((b.get('departmentId', null) == null && a.get('departmentId', null) is string && leadOf(a.departmentId) && a.position == 'member')
          || (b.get('departmentId', null) is string && leadOf(b.departmentId) && a.get('departmentId', null) == null));
    }
    match /members/{email} {
      allow read: if active();
      allow create: if active() && termOk() && isAdmin()
        && email == email.lower() && email.matches('^[^@]+@stjbs[.]sch[.]id$')
        && request.resource.data.active == true && memberOk(request.resource.data)
        && (isAdvisor() || request.resource.data.role != 'advisor')
        && (role() != 'president' || request.resource.data.role in ['officer', 'member', 'treasurer', 'secretary', 'teacher']);
      allow update: if active() && termOk() && memberOk(request.resource.data)
        && !(email == me() && changed().hasAny(['role', 'active', 'position']))
        && (isAdvisor() || deptLeadMemberEdit(email)
          || (role() == 'vp' && resource.data.role != 'advisor' && request.resource.data.role != 'advisor')
          || (role() == 'president' && resource.data.role != 'advisor'
            && changed().hasOnly(['name', 'section', 'reportsTo', 'initials', 'termId', 'updatedAt', 'departmentId', 'position'])));
    }

    // Standing departments. Admins create and edit them; a department's two officers change only its general members.
    function deptOk(d) {
      return d.keys().hasOnly(['termId', 'name', 'order', 'jcLeadUid', 'secLeadUid', 'memberUids', 'active', 'createdAt', 'updatedAt'])
        && text(d.name, 1, 60) && d.order is int && optString(d, 'jcLeadUid') && optString(d, 'secLeadUid')
        && emails(d.memberUids, 200) && d.active is bool
        && !(d.get('jcLeadUid', null) in d.memberUids) && !(d.get('secLeadUid', null) in d.memberUids);
    }
    match /departments/{id} {
      allow read: if active();
      allow create: if active() && isAdmin() && termOk() && deptOk(request.resource.data);
      allow update: if active() && termOk() && deptOk(request.resource.data) && fixed(['termId', 'createdAt'])
        && (isAdmin() || (changed().hasOnly(['memberUids', 'updatedAt']) && leadOf(id)));
    }
    // Special committees: one document each, teams inside. Admins only. Closed is read-only except reopening.
    function committeeOk(d) {
      return d.keys().hasOnly(['termId', 'name', 'startDate', 'endDate', 'status', 'chairUids', 'teams', 'createdAt', 'updatedAt', 'createdByUid'])
        && text(d.name, 1, 80) && day(d.startDate) && day(d.endDate) && d.endDate >= d.startDate
        && d.status in ['planning', 'active', 'closed'] && emails(d.get('chairUids', []), 10)
        && d.teams is list && d.teams.size() <= 30;
    }
    match /committees/{id} {
      allow read: if active();
      allow create: if active() && isAdmin() && termOk() && committeeOk(request.resource.data) && request.resource.data.status != 'closed';
      allow update: if active() && isAdmin() && termOk() && committeeOk(request.resource.data) && fixed(['termId', 'createdAt'])
        && (resource.data.status != 'closed' || changed().hasOnly(['status', 'updatedAt']));
    }

    // Items: projects, subteams and tasks. leadUids must always equal the parent's leadUids plus this item's lead,
    // read after the batch, so a lead change is valid only when the whole subtree is rewritten consistently.
    function parentAfter(d) { return getAfter(/databases/$(db)/documents/items/$(d.parentId)).data; }
    function leadsOk(d) {
      let own = d.get('leadUid', null) == null ? [] : [d.leadUid];
      return d.parentId == null
        ? d.leadUids == own && d.ancestors == []
        : d.leadUids == parentAfter(d).leadUids.concat(own) && d.ancestors == parentAfter(d).ancestors.concat([d.parentId]);
    }
    // Creating inside a subtree needs a lead of the parent or an ancestor; the new item's own lead does not count.
    function manages(d) {
      return notTeacher() && (isBoss() || (d.parentId != null && me() in parentAfter(d).leadUids));
    }
    function valid(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 80 && d.kind in ['project', 'team', 'task']
        && d.status in ['todo', 'doing', 'done'] && d.blocked is bool && d.archived is bool && d.isDeal is bool
        && d.dealStage in ['Lead', 'Contacted', 'Negotiating', 'Signed']
        && d.pledgedIdr is number && d.pledgedIdr >= 0 && d.receivedIdr is number && d.receivedIdr >= 0
        && d.get('notes', '') is string && d.get('notes', '').size() <= 2000
        && d.get('link', '') is string && d.get('link', '').size() <= 2000
        && d.get('blockedReason', '') is string && d.get('blockedReason', '').size() <= 500
        && d.get('public', false) is bool && d.get('publicBlurb', '') is string && d.get('publicBlurb', '').size() <= 140;
    }
    // Every item write stamps the server time, so clients can load a snapshot and listen only to later changes.
    function touched() { return request.resource.data.touchedAt == request.time; }
    function temporaryMinutesTask(d) {
      let m = meeting(d.get('meetingId','__none__'));
      return notTeacher() && m.termId == curTerm() && m.status == 'live' && m.minutesUid == me()
        && d.kind == 'task' && d.isDeal == false && d.parentId != null && d.archived == false && emails(d.assigneeUids,30)
        && (d.parentId in m.projectIds || d.ancestors.toSet().hasAny(m.projectIds));
    }
    match /items/{id} {
      allow read: if active();
      allow create: if active() && termOk() && touched() && request.resource.data.createdByUid == me()
        && request.resource.data.archived == false && valid(request.resource.data) && leadsOk(request.resource.data)
        && (request.resource.data.parentId == null ? isBoss() && notTeacher() : (manages(request.resource.data) || temporaryMinutesTask(request.resource.data)))
        && ((request.resource.data.get('public', false) == false && request.resource.data.get('publicBlurb', '') == '')
          || (isAdmin() && request.resource.data.parentId == null));
      allow update: if active() && termOk() && touched() && valid(request.resource.data) && leadsOk(request.resource.data)
        && fixed(['parentId', 'ancestors', 'createdByUid', 'createdAt'])
        && (fixed(['public', 'publicBlurb']) || (isAdmin() && resource.data.parentId == null))
        && (!(resource.data.get('public', false) == true && changed().hasAny(['title'])) || isAdmin())
        && ((notTeacher() && (isBoss() || me() in resource.data.leadUids))
          || (notTeacher() && me() in resource.data.assigneeUids && changed().hasOnly(
            ['status', 'blocked', 'blockedReason', 'blockedOnUid', 'notes', 'link', 'completedAt', 'updatedAt', 'touchedAt']
            .concat(resource.data.isDeal == true ? ['dealStage', 'pledgedIdr', 'receivedIdr'] : [])))
          || (temporaryMinutesTask(request.resource.data) && changed().hasOnly(['title','notes','assigneeUids','dueDate','status',
            'blocked','blockedReason','blockedOnUid','completedAt','updatedAt','touchedAt','meetingId'])));
    }

    match /comments/{id} {
      allow read: if active();
      allow create: if active() && termOk() && request.resource.data.authorUid == me()
        && request.resource.data.text is string && request.resource.data.text.size() <= 500 && request.resource.data.createdAt is number
        && request.resource.data.get('mentionUids', []) is list && request.resource.data.get('mentionUids', []).size() <= 10;
      allow delete: if active() && resource.data.authorUid == me();
    }

    // Check-ins were removed from the app. Old documents stay readable; nothing writes them any more.
    match /checkins/{id} {
      allow read: if active();
    }

    // ---- Tasks: flat, one owner, one assigner. Executives give a task to anyone, officers to their own department,
    // everyone to themselves. The owner moves its status; the assigner or an executive edits the rest.
    function isOfficer() { return role() == 'officer' || member().get('position', null) in ['jc_officer', 'sec_officer']; }
    function sameDept(uid) {
      let mine = member().get('departmentId', null);
      return mine != null && get(/databases/$(db)/documents/members/$(uid)).data.get('departmentId', null) == mine;
    }
    function mayAssign(uid) { return uid == me() || isBoss() || (isOfficer() && sameDept(uid)); }
    function taskOk(d) {
      return d.keys().hasOnly(['termId', 'title', 'ownerUid', 'assignerUid', 'dueDate', 'status', 'blockedReason', 'waitingOnUid', 'budgetId',
          'assignedAt', 'doneAt', 'createdAt', 'updatedAt', 'legacyItemId'])
        && text(d.title, 1, 120) && d.ownerUid is string && d.assignerUid is string && (d.dueDate == null || day(d.dueDate))
        && d.status in ['todo', 'doing', 'blocked', 'done']
        && (d.status == 'blocked' ? text(d.blockedReason, 1, 140) : d.blockedReason == '')
        && optString(d, 'waitingOnUid') && optString(d, 'budgetId') && d.assignedAt is number && d.createdAt is number;
    }
    match /tasks/{id} {
      allow read: if active();
      allow create: if active() && termOk() && notTeacher() && taskOk(request.resource.data) && mayAssign(request.resource.data.ownerUid)
        && (request.resource.data.assignerUid == me() || (isAdmin() && request.resource.data.get('legacyItemId', null) is string));
      allow update: if active() && termOk() && notTeacher() && taskOk(request.resource.data) && fixed(['termId', 'createdAt', 'legacyItemId'])
        && ((resource.data.ownerUid == me() && changed().hasOnly(['status', 'blockedReason', 'waitingOnUid', 'doneAt', 'updatedAt']))
          || ((resource.data.assignerUid == me() || isBoss())
            && (fixed(['ownerUid']) || mayAssign(request.resource.data.ownerUid))
            && (fixed(['assignerUid']) || request.resource.data.assignerUid == me())));
      allow delete: if active() && notTeacher() && (resource.data.assignerUid == me() || isBoss());
    }

    // ---- Budgets: one pot per event. Treasurers and admins create and edit; never deleted (active: false hides one).
    function isTreasurer() { return role() == 'treasurer'; }
    match /budgets/{id} {
      allow read: if active();
      allow create, update: if active() && termOk() && (isTreasurer() || isAdmin())
        && request.resource.data.keys().hasOnly(['termId', 'name', 'amountIdr', 'active', 'createdByUid', 'createdAt', 'updatedAt'])
        && text(request.resource.data.name, 1, 60) && request.resource.data.amountIdr is number && request.resource.data.amountIdr >= 0
        && request.resource.data.active is bool && request.resource.data.createdAt is number
        && (resource == null ? request.resource.data.createdByUid == me() : fixed(['termId', 'createdByUid', 'createdAt']));
    }

    // ---- Purchases: the permanent text record. pending -> approved or rejected (a treasurer, never the requester)
    // -> bought (requester, with a receipt photo) -> paid (a treasurer closes the batch). The advisor vetoes at any stage.
    function purchaseOk(d) {
      return d.keys().hasOnly(['termId', 'budgetId', 'requesterUid', 'item', 'specs', 'qty', 'unitIdr', 'totalIdr', 'photoIds', 'status', 'createdAt', 'updatedAt',
          'approverUid', 'decidedAt', 'paidIdr', 'changeNote', 'receiptPhotoId', 'batchId', 'boughtAt', 'paidByUid', 'paidAt', 'vetoUid', 'vetoReason', 'vetoAt'])
        && text(d.item, 1, 80) && text(d.get('specs', ''), 0, 300) && d.qty is int && d.qty >= 1 && d.qty <= 9999
        && d.unitIdr is number && d.unitIdr >= 0 && d.totalIdr is number && d.totalIdr > 0
        && d.photoIds is list && d.photoIds.size() >= 1 && d.photoIds.size() <= 3
        && d.status in ['pending', 'approved', 'rejected', 'bought', 'paid', 'vetoed'] && d.createdAt is number;
    }
    function photoAfter(id) { return getAfter(/databases/$(db)/documents/photos/$(id)).data; }
    match /purchases/{id} {
      allow read: if active();
      allow create: if active() && termOk() && notTeacher() && purchaseOk(request.resource.data)
        && request.resource.data.keys().hasOnly(['termId', 'budgetId', 'requesterUid', 'item', 'specs', 'qty', 'unitIdr', 'totalIdr', 'photoIds', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.requesterUid == me() && request.resource.data.status == 'pending'
        && get(/databases/$(db)/documents/budgets/$(request.resource.data.budgetId)).data.active == true
        && photoAfter(request.resource.data.photoIds[0]).purchaseId == id;
      allow update: if active() && termOk() && purchaseOk(request.resource.data)
        && fixed(['termId', 'budgetId', 'requesterUid', 'item', 'specs', 'qty', 'unitIdr', 'totalIdr', 'photoIds', 'createdAt'])
        && (
          // A treasurer decides someone else's request, or takes their own decision back.
          (isTreasurer() && resource.data.requesterUid != me() && changed().hasOnly(['status', 'approverUid', 'decidedAt', 'updatedAt'])
            && ((resource.data.status == 'pending' && request.resource.data.status in ['approved', 'rejected'] && request.resource.data.approverUid == me())
              || (resource.data.status in ['approved', 'rejected'] && resource.data.approverUid == me() && request.resource.data.status == 'pending')))
          // The requester bought it: amount paid and a receipt photo.
          || (resource.data.requesterUid == me() && resource.data.status == 'approved' && request.resource.data.status == 'bought'
            && changed().hasOnly(['status', 'paidIdr', 'changeNote', 'receiptPhotoId', 'batchId', 'boughtAt', 'updatedAt'])
            && request.resource.data.paidIdr is number && request.resource.data.paidIdr >= 0 && text(request.resource.data.get('changeNote', ''), 0, 140)
            && request.resource.data.batchId.matches('^[0-9]{4}-[0-9]{2}-[12]$')
            && photoAfter(request.resource.data.receiptPhotoId).purchaseId == id)
          // A treasurer closes the batch, or reopens it.
          || (isTreasurer() && changed().hasOnly(['status', 'paidByUid', 'paidAt', 'updatedAt'])
            && ((resource.data.status == 'bought' && request.resource.data.status == 'paid' && request.resource.data.paidByUid == me())
              || (resource.data.status == 'paid' && request.resource.data.status == 'bought')))
          // The advisor's veto: any stage, with a reason, kept on the record.
          || (isAdvisor() && resource.data.status != 'vetoed' && request.resource.data.status == 'vetoed'
            && changed().hasOnly(['status', 'vetoReason', 'vetoUid', 'vetoAt', 'updatedAt'])
            && text(request.resource.data.vetoReason, 1, 300) && request.resource.data.vetoUid == me() && request.resource.data.vetoAt is number)
        );
      allow delete: if active() && resource.data.requesterUid == me() && resource.data.status == 'pending';
    }

    // ---- Photos: one shrunk JPEG per document (no Cloud Storage on the free plan). deleteAfter is set when the
    // request closes; after that date any member's app may delete the photo. The owner may delete one whose request is gone.
    match /photos/{id} {
      allow read: if active();
      allow create: if active() && termOk() && notTeacher()
        && request.resource.data.keys().hasOnly(['termId', 'ownerUid', 'purchaseId', 'kind', 'data', 'createdAt', 'deleteAfter'])
        && request.resource.data.ownerUid == me() && request.resource.data.purchaseId is string && request.resource.data.kind in ['item', 'receipt']
        && request.resource.data.data is string && request.resource.data.data.size() <= 900000
        && request.resource.data.createdAt is number && request.resource.data.deleteAfter == null;
      allow update: if active() && (isTreasurer() || isAdvisor()) && changed().hasOnly(['deleteAfter'])
        && (request.resource.data.deleteAfter == null || request.resource.data.deleteAfter is number);
      allow delete: if active() && ((resource.data.deleteAfter is number && resource.data.deleteAfter <= request.time.toMillis())
        || (resource.data.ownerUid == me() && !existsAfter(/databases/$(db)/documents/purchases/$(resource.data.purchaseId))));
    }

    match /activity/{id} {
      allow read: if active();
      allow create: if active() && termOk() && request.resource.data.actorUid == me()
        && request.resource.data.text is string && request.resource.data.text.size() <= 300 && request.resource.data.createdAt is number;
    }

    match /notifications/{uid}/items/{id} {
      allow read, delete: if active() && uid == me();
      allow update: if active() && uid == me() && changed().hasOnly(['read']);
      allow create: if active() && termOk() && request.resource.data.fromUid == me()
        && request.resource.data.toUid == uid && request.resource.data.read == false
        && request.resource.data.text is string && request.resource.data.text.size() <= 300 && request.resource.data.createdAt is number;
    }

    match /templates/{id} {
      allow read: if active();
      allow create, update: if active() && termOk() && isBoss() && notTeacher();
    }

    match /settings/current {
      allow read: if active();
      allow write: if active() && isAdvisor() && request.resource.data.termId is string;
    }
    match /settings/digest {
      allow read: if active();
      allow create, update: if active() && termOk() && isBoss();
    }

    match /stats/{id} {
      allow read: if active() && isAdmin();
      allow create: if active() && isAdmin() && termOk();
    }

    // Meeting documents deliberately exclude attendance reasons and private follow-up.
    function emails(v, n) { return v is list && v.size() <= n && v.toSet().size() == v.size(); }
    function meeting(id) { return get(/databases/$(db)/documents/meetings/$(id)).data; }
    function meetingAfter(id) { return getAfter(/databases/$(db)/documents/meetings/$(id)).data; }
    function meetingControl(m) { return notTeacher() && m.hostUid == me(); }
    function meetingVisible(m) { return m.termId == curTerm() && (isAdmin() || me() in m.participantUids || m.hostUid == me() || me() in m.cohostUids || m.minutesUid == me()); }
    function meetingEditor(m) { return notTeacher() && (isAdmin() || me() == m.minutesUid); }
    function currentMeeting(id) { return meeting(id).termId == curTerm(); }
    // Action shape is validated when the sole editor changes the draft. Publication binds the exact stored actions.
    function publicEntryOk(d,kind) {
      return d is map && d.keys().hasOnly(['text','ownerUid','dueDate','status','taskId'])
        && d.text is string && d.text.size() <= 2000 && (d.ownerUid == null || d.ownerUid is string)
        && (d.dueDate == null || d.dueDate is string) && d.status is string && (d.taskId == null || d.taskId is string);
    }
    function publicRange0(v,kind) { return (v.size() <= 0 || (publicEntryOk(v[0],kind) && (v.size() <= 1 || (publicEntryOk(v[1],kind) && (v.size() <= 2 || (publicEntryOk(v[2],kind) && (v.size() <= 3 || (publicEntryOk(v[3],kind) && (v.size() <= 4 || (publicEntryOk(v[4],kind) && (v.size() <= 5 || (publicEntryOk(v[5],kind) && (v.size() <= 6 || (publicEntryOk(v[6],kind) && (v.size() <= 7 || (publicEntryOk(v[7],kind) && (v.size() <= 8 || (publicEntryOk(v[8],kind) && (v.size() <= 9 || (publicEntryOk(v[9],kind) && true)))))))))))))))))))); }
    function publicRange10(v,kind) { return (v.size() <= 10 || (publicEntryOk(v[10],kind) && (v.size() <= 11 || (publicEntryOk(v[11],kind) && (v.size() <= 12 || (publicEntryOk(v[12],kind) && (v.size() <= 13 || (publicEntryOk(v[13],kind) && (v.size() <= 14 || (publicEntryOk(v[14],kind) && (v.size() <= 15 || (publicEntryOk(v[15],kind) && (v.size() <= 16 || (publicEntryOk(v[16],kind) && (v.size() <= 17 || (publicEntryOk(v[17],kind) && (v.size() <= 18 || (publicEntryOk(v[18],kind) && (v.size() <= 19 || (publicEntryOk(v[19],kind) && true)))))))))))))))))))); }
    function publicRange20(v,kind) { return (v.size() <= 20 || (publicEntryOk(v[20],kind) && (v.size() <= 21 || (publicEntryOk(v[21],kind) && (v.size() <= 22 || (publicEntryOk(v[22],kind) && (v.size() <= 23 || (publicEntryOk(v[23],kind) && (v.size() <= 24 || (publicEntryOk(v[24],kind) && (v.size() <= 25 || (publicEntryOk(v[25],kind) && (v.size() <= 26 || (publicEntryOk(v[26],kind) && (v.size() <= 27 || (publicEntryOk(v[27],kind) && (v.size() <= 28 || (publicEntryOk(v[28],kind) && (v.size() <= 29 || (publicEntryOk(v[29],kind) && true)))))))))))))))))))); }
    function publicRange30(v,kind) { return (v.size() <= 30 || (publicEntryOk(v[30],kind) && (v.size() <= 31 || (publicEntryOk(v[31],kind) && (v.size() <= 32 || (publicEntryOk(v[32],kind) && (v.size() <= 33 || (publicEntryOk(v[33],kind) && (v.size() <= 34 || (publicEntryOk(v[34],kind) && (v.size() <= 35 || (publicEntryOk(v[35],kind) && (v.size() <= 36 || (publicEntryOk(v[36],kind) && (v.size() <= 37 || (publicEntryOk(v[37],kind) && (v.size() <= 38 || (publicEntryOk(v[38],kind) && (v.size() <= 39 || (publicEntryOk(v[39],kind) && true)))))))))))))))))))); }
