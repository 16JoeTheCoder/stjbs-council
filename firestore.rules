rules_version = '2';
// The real permission layer. Member ids are lowercased school emails; every *Uid field holds one.
// Fields added after launch (public, publicBlurb, touchedAt, mentionUids) are read with get(key, default):
// production documents written before them lack the keys, and a bare read would deny the write.
service cloud.firestore {
  match /databases/{db}/documents {
    function me() { return request.auth.token.email.lower(); }
    function member() { return get(/databases/$(db)/documents/members/$(me())).data; }
    function active() {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(db)/documents/members/$(me())) && member().active == true;
    }
    function role() { return member().role; }
    function isAdvisor() { return role() == 'advisor'; }
    function isBoss() { return role() in ['advisor', 'president', 'vp', 'treasurer', 'secretary']; }
    function isAdmin() { return role() in ['advisor', 'president', 'vp']; }
    function notTeacher() { return role() != 'teacher'; }
    function curTerm() { return get(/databases/$(db)/documents/settings/current).data.termId; }
    function termOk() { return request.resource.data.termId == curTerm(); }
    function roles() { return ['advisor', 'president', 'vp', 'treasurer', 'secretary', 'officer', 'teacher']; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function fixed(keys) { return !changed().hasAny(keys); }
    function text(s, lo, hi) { return s is string && s.size() >= lo && s.size() <= hi; }
    function day(s) { return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function hhmm(s) { return s is string && s.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'); }
    // Google Docs and Drive links only: a fixed host, a known path, plain URL characters, and no dot-segments or
    // encoded dots and slashes, so neither look-alike hosts nor the docs.google.com/url redirector get through.
    function google(u) {
      return u is string && u.size() <= 500
        && u.matches('^[A-Za-z0-9._~:/?#&=%+!$()*,;@-]+$') && !u.matches('.*([.][.]|%2[eEfF]|%5[cC]).*')
        && (u.matches('^https://docs[.]google[.]com/(document|spreadsheets|presentation|forms|drawings)/(u/[0-9]+/)?d/[A-Za-z0-9_-]+([/?#].*)?$')
          || u.matches('^https://drive[.]google[.]com/((u/[0-9]+/)?(file/d|drive/folders|drive/u/[0-9]+/folders)/[A-Za-z0-9_-]+|open[?]id=[A-Za-z0-9_-]+)([/?#&].*)?$'));
    }
    function optString(d, k) { return d.get(k, null) == null || d.get(k, null) is string; }

    match /members/{email} {
      allow read: if active();
      allow create: if active() && termOk() && isAdmin()
        && email == email.lower() && email.matches('^[^@]+@stjbs[.]sch[.]id$')
        && request.resource.data.active == true && request.resource.data.role in roles()
        && (isAdvisor() || request.resource.data.role != 'advisor')
        && (role() != 'president' || request.resource.data.role in ['officer', 'treasurer', 'secretary', 'teacher']);
      allow update: if active() && termOk() && request.resource.data.role in roles()
        && !(email == me() && changed().hasAny(['role', 'active']))
        && (isAdvisor()
          || (role() == 'vp' && resource.data.role != 'advisor' && request.resource.data.role != 'advisor')
          || (role() == 'president' && resource.data.role != 'advisor'
            && changed().hasOnly(['name', 'section', 'reportsTo', 'initials', 'termId', 'updatedAt'])));
    }

    // Items: projects, subteams and tasks. leadUids must always equal the parent's leadUids plus this item's lead,
    // read after the batch, so a lead change is valid only when the whole subtree is rewritten consistently.
    function parentAfter(d) { return getAfter(/databases/$(db)/documents/items/$(d.parentId)).data; }
    function leadsOk(d) {
      let own = d.get('leadUid', null) == null ? [] : [d.leadUid];
      return d.parentId == null
        ? d.leadUids == own && d.ancestors == []
        : d.leadUids == parentAfter(d).leadUids.concat(own) && d.ancestors == parentAfter(d).ancestors.concat([d.parentId]);
    }
    // Creating inside a subtree needs a lead of the parent or an ancestor; the new item's own lead does not count.
    function manages(d) {
      return notTeacher() && (isBoss() || (d.parentId != null && me() in parentAfter(d).leadUids));
    }
    function valid(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 80 && d.kind in ['project', 'team', 'task']
        && d.status in ['todo', 'doing', 'done'] && d.blocked is bool && d.archived is bool && d.isDeal is bool
        && d.dealStage in ['Lead', 'Contacted', 'Negotiating', 'Signed']
        && d.pledgedIdr is number && d.pledgedIdr >= 0 && d.receivedIdr is number && d.receivedIdr >= 0
        && d.get('notes', '') is string && d.get('notes', '').size() <= 2000
        && d.get('link', '') is string && d.get('link', '').size() <= 2000
        && d.get('blockedReason', '') is string && d.get('blockedReason', '').size() <= 500
        && d.get('public', false) is bool && d.get('publicBlurb', '') is string && d.get('publicBlurb', '').size() <= 140;
    }
    // Every item write stamps the server time, so clients can load a snapshot and listen only to later changes.
    function touched() { return request.resource.data.touchedAt == request.time; }
    match /items/{id} {
      allow read: if active();
      allow create: if active() && termOk() && touched() && request.resource.data.createdByUid == me()
        && request.resource.data.archived == false && valid(request.resource.data) && leadsOk(request.resource.data)
        && (request.resource.data.parentId == null ? isBoss() && notTeacher() : manages(request.resource.data))
        && ((request.resource.data.get('public', false) == false && request.resource.data.get('publicBlurb', '') == '')
          || (isAdmin() && request.resource.data.parentId == null));
      allow update: if active() && termOk() && touched() && valid(request.resource.data) && leadsOk(request.resource.data)
        && fixed(['parentId', 'ancestors', 'createdByUid', 'createdAt'])
        && (fixed(['public', 'publicBlurb']) || (isAdmin() && resource.data.parentId == null))
        && (!(resource.data.get('public', false) == true && changed().hasAny(['title'])) || isAdmin())
        && ((notTeacher() && (isBoss() || me() in resource.data.leadUids))
          || (notTeacher() && me() in resource.data.assigneeUids && changed().hasOnly(
            ['status', 'blocked', 'blockedReason', 'blockedOnUid', 'notes', 'link', 'completedAt', 'updatedAt', 'touchedAt']
            .concat(resource.data.isDeal == true ? ['dealStage', 'pledgedIdr', 'receivedIdr'] : []))));
    }

    match /comments/{id} {
      allow read: if active();
      allow create: if active() && termOk() && request.resource.data.authorUid == me()
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && request.resource.data.get('mentionUids', []) is list && request.resource.data.get('mentionUids', []).size() <= 10;
      allow delete: if active() && resource.data.authorUid == me();
    }

    match /checkins/{id} {
      allow read: if active();
      allow create, update: if active() && termOk() && request.resource.data.uid == me()
        && id == request.resource.data.termId + '_' + request.resource.data.weekId + '_' + me();
    }

    match /activity/{id} {
      allow read: if active();
      allow create: if active() && termOk() && request.resource.data.actorUid == me();
    }

    match /notifications/{uid}/items/{id} {
      allow read, delete: if active() && uid == me();
      allow update: if active() && uid == me() && changed().hasOnly(['read']);
      allow create: if active() && termOk() && request.resource.data.fromUid == me()
        && request.resource.data.toUid == uid && request.resource.data.read == false;
    }

    match /templates/{id} {
      allow read: if active();
      allow create, update: if active() && termOk() && isBoss() && notTeacher();
    }

    match /settings/current {
      allow read: if active();
      allow write: if active() && isAdvisor() && request.resource.data.termId is string;
    }
    match /settings/digest {
      allow read: if active();
      allow create, update: if active() && termOk() && isBoss();
    }

    match /stats/{id} {
      allow read: if active() && isAdmin();
      allow create: if active() && isAdmin() && termOk();
    }

    // ---- Added with the Fiat Lux redesign. Nothing below can be deleted; documents are archived instead.

    function annOk(d) {
      return d.keys().hasOnly(['termId', 'title', 'body', 'audience', 'startDate', 'endDate', 'createdByUid', 'archived', 'createdAt', 'updatedAt'])
        && text(d.title, 1, 80) && d.body is string && d.body.size() <= 2000 && d.audience in ['everyone', 'members']
        && day(d.startDate) && day(d.endDate) && d.endDate >= d.startDate && d.archived is bool;
    }
    match /announcements/{id} {
      allow read: if active();
      allow create: if active() && isAdmin() && termOk() && annOk(request.resource.data)
        && request.resource.data.createdByUid == me() && request.resource.data.archived == false;
      allow update: if active() && isAdmin() && termOk() && annOk(request.resource.data)
        && fixed(['termId', 'createdByUid', 'createdAt']);
    }

    function eventOk(d) {
      return d.keys().hasOnly(['termId', 'title', 'type', 'date', 'start', 'end', 'location', 'notes', 'public', 'itemId',
          'createdByUid', 'archived', 'createdAt', 'updatedAt'])
        && text(d.title, 1, 80) && d.type in ['meeting', 'project', 'committee', 'other'] && day(d.date)
        && hhmm(d.start) && hhmm(d.end) && d.end >= d.start
        && d.location is string && d.location.size() <= 120 && d.notes is string && d.notes.size() <= 1000
        && d.public is bool && d.archived is bool && optString(d, 'itemId');
    }
    match /events/{id} {
      allow read: if active();
      allow create: if active() && notTeacher() && termOk() && eventOk(request.resource.data)
        && request.resource.data.createdByUid == me() && request.resource.data.archived == false
        && (request.resource.data.public == false || isAdmin());
      allow update: if active() && notTeacher() && termOk() && eventOk(request.resource.data)
        && (resource.data.createdByUid == me() || isBoss())
        && fixed(['termId', 'createdByUid', 'createdAt'])
        && (fixed(['public']) || isAdmin())
        && (!(resource.data.get('public', false) == true && changed().hasAny(['title', 'type', 'date', 'start', 'end', 'location'])) || isAdmin());
    }

    match /rsvps/{id} {
      allow read: if active();
      allow create, update: if active() && notTeacher() && termOk()
        && request.resource.data.keys().hasOnly(['termId', 'eventId', 'uid', 'status', 'archived', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == me() && request.resource.data.eventId is string
        && id == request.resource.data.eventId + '_' + me()
        && request.resource.data.status in ['going', 'not'] && request.resource.data.archived == false
        && exists(/databases/$(db)/documents/events/$(request.resource.data.eventId));
    }

    // A vote adds or removes exactly the caller, once: [me, me, me] and swapping someone else out both fail.
    function voteOk(n, o) {
      return n is list && n.toSet().size() == n.size()
        && ((n.size() == o.size() + 1 && n.toSet().difference(o.toSet()).size() == 1
            && n.toSet().difference(o.toSet()).hasAll([me()]) && o.toSet().difference(n.toSet()).size() == 0)
          || (n.size() == o.size() - 1 && o.toSet().difference(n.toSet()).size() == 1
            && o.toSet().difference(n.toSet()).hasAll([me()]) && n.toSet().difference(o.toSet()).size() == 0));
    }
    match /ideas/{id} {
      allow read: if active();
      allow create: if active() && notTeacher() && termOk()
        && request.resource.data.keys().hasOnly(['termId', 'text', 'authorUid', 'voters', 'archived', 'createdAt', 'updatedAt'])
        && text(request.resource.data.text, 1, 140) && request.resource.data.authorUid == me()
        && request.resource.data.voters == [me()] && request.resource.data.archived == false;
      allow update: if active() && termOk()
        && ((notTeacher() && changed().hasOnly(['voters']) && voteOk(request.resource.data.voters, resource.data.voters))
          || (isAdmin() && changed().hasOnly(['archived', 'updatedAt']) && request.resource.data.archived is bool));
    }

    function tplOk(d) {
      return d.keys().hasOnly(['name', 'kind', 'url', 'version', 'archived', 'createdAt', 'updatedAt'])
        && text(d.name, 1, 80) && d.kind is string && d.kind.size() <= 40 && google(d.url)
        && d.version is int && d.archived is bool;
    }
    match /docTemplates/{id} {
      allow read: if active();
      allow create: if active() && isAdmin() && tplOk(request.resource.data)
        && request.resource.data.version == 1 && request.resource.data.archived == false;
      allow update: if active() && isAdmin() && tplOk(request.resource.data) && fixed(['createdAt'])
        && request.resource.data.version == (changed().hasAny(['url']) ? resource.data.version + 1 : resource.data.version);
    }

    // The handover archive and template suggestions. Cross-term: no termId, so they survive Close term.
    match /submissions/{id} {
      allow read: if active() && (resource.data.byUid == me() || isAdmin());
      allow create: if active() && notTeacher()
        && request.resource.data.keys().hasOnly(['type', 'name', 'url', 'targetId', 'projectId', 'note', 'byUid', 'status', 'archived', 'createdAt'])
        && request.resource.data.byUid == me() && request.resource.data.type in ['new-template', 'template-edit', 'archive']
        && text(request.resource.data.name, 1, 80) && google(request.resource.data.url)
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && optString(request.resource.data, 'targetId') && optString(request.resource.data, 'projectId')
        && (request.resource.data.type != 'template-edit' || request.resource.data.get('targetId', null) is string)
        && request.resource.data.status == (request.resource.data.type == 'archive' ? 'filed' : 'pending')
        && request.resource.data.archived == false && request.resource.data.createdAt is number;
      allow update: if active() && isAdmin() && changed().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'approved', 'rejected', 'filed'];
    }

    // The public website reads this one document over REST without signing in. It holds no names or emails.
    match /public/feed {
      allow get: if true;
      allow create, update: if active() && isAdmin()
        && request.resource.data.keys().hasOnly(['json', 'hash', 'updatedAt'])
        && request.resource.data.json is string && request.resource.data.json.size() <= 200000
        && request.resource.data.hash is string && request.resource.data.updatedAt is number;
    }

    // One document per term holding every live item, so a cold open costs one read instead of hundreds.
    match /cache/{termId} {
      allow read: if active();
      allow create, update: if active() && isAdmin() && termId == curTerm()
        && request.resource.data.keys().hasOnly(['json', 'at', 'count', 'updatedAt'])
        && request.resource.data.json is string && request.resource.data.json.size() <= 700000
        && request.resource.data.at is timestamp && request.resource.data.at <= request.time
        && request.resource.data.count is int && request.resource.data.updatedAt is number;
    }
  }
}
