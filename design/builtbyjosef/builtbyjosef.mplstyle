# builtbyjosef matplotlib style. Use: plt.style.use("builtbyjosef.mplstyle")
# Space Grotesk must be installed as a TTF/OTF on the machine (matplotlib cannot read woff2); download it from Google Fonts. Otherwise it falls back to DejaVu Sans.
font.family: Space Grotesk, DejaVu Sans
font.size: 11
figure.facecolor: F3F2EE
savefig.facecolor: F3F2EE
axes.facecolor: F3F2EE
axes.edgecolor: 5E6167
axes.labelcolor: 4A4D53
axes.titlecolor: 0D0E10
axes.titleweight: bold
axes.titlesize: 13
axes.titlelocation: left
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.axisbelow: True
grid.color: D3D0C7
grid.linewidth: 1
xtick.color: 4A4D53
ytick.color: 4A4D53
text.color: 0D0E10
lines.linewidth: 2
lines.solid_capstyle: round
axes.prop_cycle: cycler('color', ['D9480F', '0B63C5', '00796B', 'A8326F', '9A6700', '4A4D53'])
legend.frameon: False
figure.dpi: 120
