{
  "name": "stjbs-council",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "demo": "firebase emulators:exec --only auth,firestore --project demo-council \"node scripts/seed-emulator.mjs && vite --mode emulator\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-council \"node --test tests/rules.test.mjs\"",
    "check": "bash design/fiatlux/design-check.sh && vite build --logLevel error && node scripts/check-site-bundle.mjs",
    "deploy": "vite build && firebase deploy --only hosting,firestore"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@preact/preset-vite": "^2.10.6",
    "firebase-tools": "^15.34.1",
    "vite": "^8.3.5"
  }
}
